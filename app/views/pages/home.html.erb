<% content_for :meta_title, "Gooi - Organic Waste Recycling Made Easy in Cape Town" %>
<% content_for :meta_description, "Weekly doorstep collection of food scraps around Table Mountain. Join Cape Town's food waste revolution. Simple, affordable composting service for households and businesses." %>

<% content_for :structured_data do %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Weekly Compost Collection",
  "provider": { "@id": "<%= root_url %>" },
  "areaServed": "Cape Town",
  "description": "Weekly doorstep collection of food scraps from households and businesses around Table Mountain. Affordable, easy composting — two subscription plans available.",
  "offers": [
    {
      "@type": "Offer",
      "name": "Standard Plan",
      "description": "Up to two 5L bags per week",
      "price": "180",
      "priceCurrency": "ZAR",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "180",
        "priceCurrency": "ZAR",
        "unitText": "month",
        "description": "From R180/month on 6-month plan"
      }
    },
    {
      "@type": "Offer",
      "name": "XL Plan",
      "description": "One 25L bucket per week",
      "price": "240",
      "priceCurrency": "ZAR",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "240",
        "priceCurrency": "ZAR",
        "unitText": "month",
        "description": "From R240/month on 6-month plan"
      }
    }
  ]
}
</script>
<% end %>

<%# Phase 2 homepage overhaul (docs/gooi-public-ui-overhaul-brief.md) — one
    render call per section, matching the brief's target order. Nav and
    footer are global layout partials, not rendered here. %>
<div class="page-container">
  <%= render "pages/home/hero" %>
  <%= render "pages/home/how_it_works" %>
  <%= render "pages/home/what_you_can_gooi" %>
  <%= render "pages/home/pricing" %>

  <%= render "shared/impact_stats",
        total_kg: @total_kg,
        kg_this_week: @kg_this_week,
        household_count: @household_count %>

  <%= render "pages/home/where_we_collect" %>
  <%= render "pages/home/waitlist" %>
  <%= render "pages/home/testimonials" %>
  <%# Gooi feed section commented out, not deleted — bring back once there's
      a real curated image set / the Instagram API is wired up.
      render "pages/home/gooi_feed" %>
  <%= render "pages/home/b2b_band" %>
  <%= render "pages/home/faq" %>
</div>

<% unless user_signed_in? %>
  <%= render "pages/app_nudge" %>
<% end %>
