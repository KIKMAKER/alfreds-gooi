<%# Phase 2 homepage overhaul, section 8: waitlist prompt + modal.
    Was a full inline section — the user felt it took up too much of the
    homepage, so it's now a small "Don't see your suburb?" prompt right
    after the map that opens a modal containing the same form. Same
    Interest model/InterestsController as before (confirmed with the
    user), same "seed #N" nudge (also confirmed — derived from existing
    Interest counts grouped by suburb_id, no schema change). %>
<div class="waitlist-prompt" data-controller="modal" data-action="keydown@window->modal#closeOnEscape">
  <p class="waitlist-prompt__text">
    Don't see your suburb?
    <button type="button" class="waitlist-prompt__link" data-action="click->modal#open">Let us know</button>
    — we're expanding weekly.
  </p>

  <div class="modal" data-modal-target="dialog" data-action="click->modal#closeBackground">
    <div class="modal__panel" data-controller="waitlist-count" data-waitlist-count-counts-value="<%= @interest_counts.to_json %>">
      <button type="button" class="modal__close" aria-label="Close" data-action="click->modal#close">&times;</button>

      <h3 id="interest">Think we should gooi in your 'hood?</h3>
      <p class="my-2">If your address isn't on our route yet, please leave your details so we can get to you soon! You can also spread the word to your neighbours to help the compost movement grow.</p>

      <%= simple_form_for @interest do |f| %>
        <%= f.input :name, input_html: { class: 'form-control' } %>
        <%= f.input :email, input_html: { class: 'form-control' } %>
        <%= f.association :suburb,
              collection: Suburb.target.order(:name),
              label_method: :name,
              include_blank: "Other",
              input_html: {
                class: 'form-select',
                data: { waitlist_count_target: "select", action: "change->waitlist-count#update" }
              } %>
        <p data-waitlist-count-target="line" class="waitlist-seed-line"></p>
        <%= f.input :note, as: :text,
              label: "Anything to add?",
              placeholder: "e.g. 'My whole street would sign up' or 'We have a community garden'",
              hint: "If your suburb isn't in the list, select Other and mention it here.",
              input_html: { class: 'form-control', rows: 2 },
              required: false %>
        <%= hidden_field_tag :website, nil, autocomplete: "off" %>
        <%= f.submit "Plant the seed", class: "submit-btn" %>
      <% end %>
    </div>
  </div>
</div>
