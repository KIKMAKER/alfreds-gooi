<%# Phase 2 homepage overhaul, section 8: waitlist form.
    Relocated from directly after the map (unchanged) to right after the
    "where we collect" section, per the brief. Same Interest model/
    InterestsController as before — confirmed with the user, no schema
    change. Adds the "seed #N" nudge (also confirmed with the user):
    derived from existing Interest counts grouped by suburb_id
    (PagesController#home's @interest_counts), not a new column. %>
<section class="map-section" style="margin-top: 0; padding-top: 0;">
  <div class="interest-card popular mt-4" data-controller="waitlist-count" data-waitlist-count-counts-value="<%= @interest_counts.to_json %>">
    <h3 class="mt-4" id="interest">Think we should gooi in your 'hood?</h3>
    <p class="my-2">If your address isn't on our route yet, please leave your details so we can get to you soon! You can also spread the word to your neighbours to help the compost movement grow.</p>

    <%= simple_form_for @interest do |f| %>
      <%= f.input :name, input_html: { class: 'form-control' } %>
      <%= f.input :email, input_html: { class: 'form-control' } %>
      <%= f.association :suburb,
            collection: Suburb.target.order(:name),
            label_method: :name,
            include_blank: "Other",
            input_html: {
              class: 'form-select',
              data: { waitlist_count_target: "select", action: "change->waitlist-count#update" }
            } %>
      <p data-waitlist-count-target="line" class="waitlist-seed-line"></p>
      <%= f.input :note, as: :text,
            label: "Anything to add?",
            placeholder: "e.g. 'My whole street would sign up' or 'We have a community garden'",
            hint: "If your suburb isn't in the list, select Other and mention it here.",
            input_html: { class: 'form-control', rows: 2 },
            required: false %>
      <%= hidden_field_tag :website, nil, autocomplete: "off" %>
      <%= f.submit "Plant the seed", class: "submit-btn" %>
    <% end %>
  </div>
</section>
