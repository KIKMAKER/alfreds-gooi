<%# Phase 2 homepage overhaul, section 4: how gooi works.
    Sits directly below the hero (user's explicit call, overriding the
    brief's literal order which had the impact strip here) — bakkie photo
    left, 3 numbered steps right, Alfred named in step 3. %>
<section id="how-it-works" class="how-it-works">
  <div class="how-it-works__inner">
    <h2 class="how-it-works__title">How gooi works</h2>
    <p class="how-it-works__subtitle">Three easy steps. No bin juice, no guilt, no landfill.</p>

    <div class="how-it-works__grid">
      <div class="how-it-works__image-wrap">
        <%= image_tag "suburb_launch_bakkie.jpeg", alt: "The gooi bakkie loaded with buckets, ready for its weekly route", class: "how-it-works__image" %>
      </div>

      <ol class="how-it-works__steps">
        <li class="how-it-works__step">
          <span class="how-it-works__step-number">1</span>
          <div>
            <h3 class="how-it-works__step-title">Get your bucket</h3>
            <p class="how-it-works__step-desc">We drop off your gooi bucket with compostable liners, ready to fill.</p>
          </div>
        </li>
        <li class="how-it-works__step">
          <span class="how-it-works__step-number">2</span>
          <div>
            <h3 class="how-it-works__step-title">Fill it all week</h3>
            <p class="how-it-works__step-desc">Toss in fruit, veg, coffee grounds and eggshells as you cook.</p>
          </div>
        </li>
        <li class="how-it-works__step">
          <span class="how-it-works__step-number">3</span>
          <div>
            <h3 class="how-it-works__step-title">Alfred collects &amp; composts</h3>
            <p class="how-it-works__step-desc">He loops your neighbourhood weekly, and your scraps become compost, not landfill.</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>
