<%# Phase 2 homepage overhaul, section 7: where we collect.
    Rebuilt to match the reference layout: full-width map, toggle pills +
    legend on one row above it, four info cards in a row below. Same
    Mapbox map/data/Stimulus controller as before (IntersectionObserver
    lazy-load, see app/javascript/controllers/service_map_controller.js) —
    only the surrounding layout changed. %>
<section id="where-we-collect" class="where-we-collect">
  <div class="where-we-collect__inner">
    <h2 class="where-we-collect__title">Where we collect</h2>
    <p class="where-we-collect__subtitle">The gooi bakkie loops Cape Town once a week.</p>

    <p class="where-we-collect__subtitle">
      Click a suburb on the map, or
      <%= link_to "learn about gooi in your suburb", suburbs_path %> for the full list.
    </p>

    <div
      class="where-we-collect__map-wrap"
      data-controller="service-map"
      data-service-map-token-value="<%= Rails.application.credentials.dig(:mapbox, :public_token) || ENV['MAPBOX_API_KEY'] %>"
      data-service-map-geo-url-value="<%= asset_path('Suburbs.geojson') %>"
      data-service-map-collection-days-value="<%= Suburb.active.pluck(:name, :collection_day).to_h.to_json %>"
      data-service-map-suburb-slugs-value="<%= @suburb_slugs_by_name.to_json %>">

      <div class="where-we-collect__controls">
        <div class="where-we-collect__toggle">
          <strong>Toggle:</strong>
          <div class="filter-buttons">
            <button class="btn-gooi-outline active" type="button" data-day-filter="all">All</button>
            <button class="btn-gooi-outline" type="button" data-day-filter="Monday">Monday</button>
            <button class="btn-gooi-outline" type="button" data-day-filter="Tuesday">Tuesday</button>
            <button class="btn-gooi-outline" type="button" data-day-filter="Wednesday">Wednesday</button>
            <button class="btn-gooi-outline" type="button" data-day-filter="Thursday">Thursday</button>
          </div>
        </div>
        <div class="where-we-collect__legend" id="service-map-legend"></div>
      </div>

      <div id="service-map" class="where-we-collect__map"></div>
    </div>

    <p class="where-we-collect__note">
      <strong>Heads-up:</strong> boundaries are indicative; if you're on the edge we'll
      confirm your day.
    </p>

    <div class="where-we-collect__cards">
      <div class="small-icon-card">
        <div class="icon-card-header">
          <i class="fa-solid fa-route fs-4"></i>
          <span class="icon-title">Weekly collection</span>
        </div>
        <p>The gooi bakkie loops Cape Town once a week.</p>
      </div>
      <div class="small-icon-card">
        <div class="icon-card-header">
          <i class="fa-regular fa-clock fs-4"></i>
          <span class="icon-title">Consistent-ish timing</span>
        </div>
        <p>Traffic &amp; Alfred's chats can nudge times a bit.</p>
      </div>
      <div class="small-icon-card">
        <div class="icon-card-header">
          <i class="fa-regular fa-calendar-days fs-4"></i>
          <span class="icon-title">Your day = your 'hood</span>
        </div>
        <p>See Monday&ndash;Thursday zones on the map.</p>
      </div>
      <div class="small-icon-card">
        <div class="icon-card-header">
          <i class="fa-regular fa-circle-check fs-4"></i>
          <span class="icon-title">Always current</span>
        </div>
        <p>Routes evolve as we grow; this map stays up to date.</p>
      </div>
    </div>
  </div>
</section>
