<%# Phase 2 homepage overhaul, section 5: what you can gooi.
    Dark-green wavy band (matches the reference mockup) with a green "Yes"
    card and a white "Nope" card side by side. Also an SEO asset, so this
    is marked up as real content (a list), not just decorative. %>
<section id="what-you-can-gooi" class="what-you-can-gooi">
  <%= raw %(
        <div class="wave-edge wave-edge--top">
          <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
              <path id="gooi-list-wave-top" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-352z" />
            </defs>
            <use href="#gooi-list-wave-top" x="0" y="0" />
          </svg>
        </div>
      ) %>

  <div class="what-you-can-gooi__inner">
    <h2 class="what-you-can-gooi__title">What you can gooi</h2>
    <p class="what-you-can-gooi__subtitle">Most of your kitchen, actually. Here's the quick cheat sheet.</p>

    <div class="what-you-can-gooi__columns">
      <div class="what-you-can-gooi__column what-you-can-gooi__column--yes">
        <h3 class="what-you-can-gooi__column-title">Yes — gooi it</h3>
        <ul class="what-you-can-gooi__list">
          <li>Fruit &amp; veg scraps</li>
          <li>Coffee grounds &amp; filters</li>
          <li>Tea bags</li>
          <li>Eggshells</li>
          <li>Bread, grains &amp; pasta</li>
          <li>Dead leaves &amp; plant matter</li>
          <li>Paper towels &amp; napkins</li>
        </ul>
      </div>

      <div class="what-you-can-gooi__column what-you-can-gooi__column--no">
        <h3 class="what-you-can-gooi__column-title">Nope — not these</h3>
        <ul class="what-you-can-gooi__list">
          <li>Meat &amp; dairy</li>
          <li>Pet waste</li>
          <li>Glass <span>(recycle it!)</span></li>
          <li>Medication</li>
          <li>Fats &amp; cooking oil</li>
          <li>Diseased plants</li>
        </ul>
      </div>
    </div>

    <p class="what-you-can-gooi__link">
      <%= link_to "See the full list", about_path(anchor: "what-is-compostable") %>
    </p>
  </div>

  <%= raw %(
        <div class="wave-edge wave-edge--bottom">
          <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
              <path id="gooi-list-wave-bottom" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-352z" />
            </defs>
            <use href="#gooi-list-wave-bottom" x="0" y="0" />
          </svg>
        </div>
      ) %>
</section>
