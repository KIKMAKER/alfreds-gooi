<%# Phase 2 homepage overhaul, section 6: pricing.
    Standard/XL toggle and all discount/referral-code price math are
    unchanged from the previous inline version — only relocated, restyled,
    and given a duration selector (Stimulus, defaults to 6 months: the 1-
    and 3-month cards start with the `hide` class server-side, so this is
    correct even before JS loads). "From R180/mo" anchor style is used for
    the plain (no code) case per the brief's pricing decision — the
    strikethrough only appears when a real discount/referral is active,
    which is a genuine saving, not a fake anchor price. %>
<section data-controller="pricing" class="pricing" id="pricing">
  <div class="pricing__inner">
    <p class="pricing__eyebrow">Weekly collection service</p>
    <h2 class="pricing__title">Choose your plan</h2>
    <p class="pricing__subtitle">
      Standard covers the average small household — up to two 5L bags a week.
      Bigger family, or just a very avid juicer? XL fills a 25L bucket weekly.
    </p>

    <% if @referral_code %>
      <div class="yellow-block">
        <h2>You have a referral code!</h2>
        <h2>Get 15% off any of the below options.</h2>
      </div>
    <% elsif @discount_code %>
      <% if @discount_percent.present? %>
        <div class="yellow-block">
          <h2>You have a discount code!</h2>
          <h2>Get <strong><%= number_to_percentage(@discount_percent * 100, precision: 0) %></strong> off any of the below options.</h2>
        </div>
      <% else %>
        <div class="yellow-block">
          <h2>You have a discount code!</h2>
          <h2>Get <strong>R<%= number_with_precision(@discount_amount || @discount_code_value, precision: 2) %></strong> off any of the below options.</h2>
        </div>
      <% end %>
    <% end %>

    <div class="toggle-subscription">
      <h2>Subscription rates</h2>
      <div class="toggle">
        <h5 data-pricing-target="title">Standard</h5>
        <div class="toggle-container">
          <input type="checkbox" id="check" class="toggle d-none" data-action="click->pricing#toggle">
          <label for="check" class="toggle-label"></label>
        </div>
        <h5>XL</h5>
      </div>

      <div class="duration-pills">
        <button type="button" class="duration-pill" data-duration-pill data-duration="1" data-action="click->pricing#selectDuration">1 month</button>
        <button type="button" class="duration-pill" data-duration-pill data-duration="3" data-action="click->pricing#selectDuration">3 months</button>
        <button type="button" class="duration-pill duration-pill--active" data-duration-pill data-duration="6" data-action="click->pricing#selectDuration">6 months</button>
      </div>
    </div>

    <% if @referral_code %>
      <div class="standard-months-container" data-pricing-target="standard">
        <div class="month-card hide" data-duration="1">
          <h3>1 month</h3>
          <p class="pricing-text"><s>R260</s> <strong>R<%= number_with_precision(260 * 0.85, precision: 2) %></strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> <s>R260</s> <strong>R<%= number_with_precision(260 * 0.85, precision: 2) %></strong></p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '1', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
        <div class="month-card hide" data-duration="3">
          <h3>3 months</h3>
          <p class="pricing-text"><s>R220</s> <strong>R<%= number_with_precision(220 * 0.85, precision: 2) %></strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> <s>R660</s> <strong>R<%= number_with_precision(660 * 0.85, precision: 2) %></strong></p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '3', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
        <div class="month-card popular" data-duration="6">
          <h4>Most popular</h4>
          <h3>6 months</h3>
          <p class="pricing-text"><s>R180</s> <strong>R<%= number_with_precision(180 * 0.85, precision: 2) %></strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> <s>R1080</s> <strong>R<%= number_with_precision(1080 * 0.85, precision: 2) %></strong></p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '6', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
      </div>

      <div class="standard-months-container hide" data-pricing-target="extra">
        <div class="month-card hide" data-duration="1">
          <h3>1 month</h3>
          <p class="pricing-text"><s>R300</s> <strong>R<%= number_with_precision(300 * 0.85, precision: 2) %></strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> <s>R300</s> <strong>R<%= number_with_precision(300 * 0.85, precision: 2) %></strong></p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '1', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
        <div class="month-card hide" data-duration="3">
          <h3>3 months</h3>
          <p class="pricing-text"><s>R270</s> <strong>R<%= number_with_precision(270 * 0.85, precision: 2) %></strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> <s>R810</s> <strong>R<%= number_with_precision(810 * 0.85, precision: 2) %></strong></p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '3', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
        <div class="month-card" data-duration="6">
          <h3>6 months</h3>
          <p class="pricing-text"><s>R240</s> <strong>R<%= number_with_precision(240 * 0.85, precision: 2) %></strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> <s>R1440</s> <strong>R<%= number_with_precision(1440 * 0.85, precision: 2) %></strong></p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '6', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
      </div>

    <% elsif @discount_code %>
      <div class="standard-months-container" data-pricing-target="standard">
        <%# 1 month (260) %>
        <% orig = 260.0; dur = 1.0
          total = if @discount_code&.upcase == "NEWSOIL26"
                    orig * dur
                  elsif @pct.positive?
                    orig * dur * (1 - @pct)
                  else
                    [orig * dur - @amt, 0].max
                  end
          per = total / dur
          has_discount = (total < orig * dur) %>
        <div class="month-card hide" data-duration="1">
          <h3>1 month</h3>
          <p class="pricing-text">
            <% if has_discount %><s>R<%= number_with_precision(orig, precision: 2) %></s><% end %>
            <strong>R<%= number_with_precision(per, precision: 2) %></strong> per month
          </p>
          <p class="pricing-text">
            <strong>Total:</strong>
            <% if has_discount %><s>R<%= number_with_precision(orig * dur, precision: 2) %></s><% end %>
            <strong>R<%= number_with_precision(total, precision: 2) %></strong>
          </p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '1', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>

        <%# 3 months (220 * 3 = 660) %>
        <% orig = 220.0; dur = 3.0
          total = @pct.positive? ? (orig * dur * (1 - @pct)) : [orig * dur - @amt, 0].max
          per = total / dur %>
        <div class="month-card hide" data-duration="3">
          <h3>3 months</h3>
          <p class="pricing-text"><s>R<%= number_with_precision(orig, precision: 2) %></s> <strong>R<%= number_with_precision(per, precision: 2) %></strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> <s>R<%= number_with_precision(orig * dur, precision: 2) %></s> <strong>R<%= number_with_precision(total, precision: 2) %></strong></p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '3', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>

        <%# 6 months (180 * 6 = 1080) %>
        <% orig = 180.0; dur = 6.0
          total = if @discount_code&.upcase == "NEWSOIL26"
                    orig * dur
                  elsif @pct.positive?
                    orig * dur * (1 - @pct)
                  else
                    [orig * dur - @amt, 0].max
                  end
          per = total / dur
          has_discount = (total < orig * dur) %>
        <div class="month-card popular" data-duration="6">
          <h4>Most popular</h4>
          <h3>6 months</h3>
          <p class="pricing-text">
            <% if has_discount %><s>R<%= number_with_precision(orig, precision: 2) %></s><% end %>
            <strong>R<%= number_with_precision(per, precision: 2) %></strong> per month
          </p>
          <p class="pricing-text">
            <strong>Total:</strong>
            <% if has_discount %><s>R<%= number_with_precision(orig * dur, precision: 2) %></s><% end %>
            <strong>R<%= number_with_precision(total, precision: 2) %></strong>
          </p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '6', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
      </div>

      <div class="standard-months-container hide" data-pricing-target="extra">
        <%# XL 1 month (300) %>
        <% orig = 300.0; dur = 1.0
          total = if @discount_code&.upcase == "NEWSOIL26"
                    orig * dur
                  elsif @pct.positive?
                    orig * dur * (1 - @pct)
                  else
                    [orig * dur - @amt, 0].max
                  end
          per = total / dur
          has_discount = (total < orig * dur) %>
        <div class="month-card hide" data-duration="1">
          <h3>1 month</h3>
          <p class="pricing-text">
            <% if has_discount %><s>R<%= number_with_precision(orig, precision: 2) %></s><% end %>
            <strong>R<%= number_with_precision(per, precision: 2) %></strong> per month
          </p>
          <p class="pricing-text">
            <strong>Total:</strong>
            <% if has_discount %><s>R<%= number_with_precision(orig * dur, precision: 2) %></s><% end %>
            <strong>R<%= number_with_precision(total, precision: 2) %></strong>
          </p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '1', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>

        <%# XL 3 months (270 * 3 = 810) %>
        <% orig = 270.0; dur = 3.0
          total = @pct.positive? ? (orig * dur * (1 - @pct)) : [orig * dur - @amt, 0].max
          per = total / dur %>
        <div class="month-card hide" data-duration="3">
          <h3>3 months</h3>
          <p class="pricing-text"><s>R<%= number_with_precision(orig, precision: 2) %></s> <strong>R<%= number_with_precision(per, precision: 2) %></strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> <s>R<%= number_with_precision(orig * dur, precision: 2) %></s> <strong>R<%= number_with_precision(total, precision: 2) %></strong></p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '3', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>

        <%# XL 6 months (240 * 6 = 1440) %>
        <% orig = 240.0; dur = 6.0
          total = if @discount_code&.upcase == "NEWSOIL26"
                    orig * dur
                  elsif @pct.positive?
                    orig * dur * (1 - @pct)
                  else
                    [orig * dur - @amt, 0].max
                  end
          per = total / dur
          has_discount = (total < orig * dur) %>
        <div class="month-card" data-duration="6">
          <h3>6 months</h3>
          <p class="pricing-text">
            <% if has_discount %><s>R<%= number_with_precision(orig, precision: 2) %></s><% end %>
            <strong>R<%= number_with_precision(per, precision: 2) %></strong> per month
          </p>
          <p class="pricing-text">
            <strong>Total:</strong>
            <% if has_discount %><s>R<%= number_with_precision(orig * dur, precision: 2) %></s><% end %>
            <strong>R<%= number_with_precision(total, precision: 2) %></strong>
          </p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '6', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
      </div>

    <% else %>
      <div class="standard-months-container" data-pricing-target="standard">
        <div class="month-card hide" data-duration="1">
          <h3>1 month</h3>
          <p class="pricing-text"><strong>R260</strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> R260</p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '1', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
        <div class="month-card hide" data-duration="3">
          <h3>3 months</h3>
          <p class="pricing-text"><strong>R220</strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> R660</p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '3', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
        <div class="month-card popular" data-duration="6">
          <h4>Most popular</h4>
          <h3>6 months</h3>
          <p class="pricing-text"><strong>From R180</strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> R1080</p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'Standard', duration: '6', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
      </div>
      <div class="standard-months-container hide" data-pricing-target="extra">
        <div class="month-card hide" data-duration="1">
          <h3>1 month</h3>
          <p class="pricing-text"><strong>R300</strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> R300</p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '1', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
        <div class="month-card hide" data-duration="3">
          <h3>3 months</h3>
          <p class="pricing-text"><strong>R270</strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> R810</p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '3', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
        <div class="month-card" data-duration="6">
          <h3>6 months</h3>
          <p class="pricing-text"><strong>From R240</strong> per month</p>
          <p class="pricing-text"><strong>Total:</strong> R1440</p>
          <div class="sign-up-btn">
            <%= link_to 'Select', new_account_signup_path(plan: 'XL', duration: '6', discount_code: @discount_code, referral: @referral_code), class: "link-title-light" %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="other-options-section mt-5">
      <h2 class="other-options-title">Once-off collection</h2>
      <div class="other-options-row">
        <div class="other-option-card other-option-card--once-off">
          <h3>Once-off Collection</h3>
          <p>Dinner party or overflowing worm bin, we're happy to help get your extra waste into the soil.</p>
          <ul>
            <li>One collection of your organic waste</li>
            <li>No commitment, no recurring charges</li>
            <li>Pick your collection date based on our route</li>
          </ul>
          <p class="other-option-price">R<%= number_with_precision(@once_off_price, precision: 0) %></p>
          <div class="mt-auto pt-3">
            <%= link_to 'Book Now', new_account_signup_path(plan: 'once_off'), class: 'btn-gooi' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
