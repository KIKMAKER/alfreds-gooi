<%# Phase 2 homepage overhaul, section 6: pricing (rebuilt per the reference
    mockup — three side-by-side cards, each with its own 1/3/6-month
    duration toggle, defaulting to 6 months server-side via the `hide`
    class on the 1/3-month panels). Discount/referral-code math is
    unchanged, just extracted into app/services/plan_pricing.rb so it
    isn't tripled per duration. "From R180/mo" anchor style is used for
    the plain (no code) case — the strikethrough only appears for a real
    active discount/referral, which is a genuine saving, not a fake
    anchor price. %>
<section class="pricing" id="pricing">
  <div class="pricing__inner">
    <p class="pricing__eyebrow">Weekly collection service</p>
    <h2 class="pricing__title">Simple monthly plans</h2>
    <p class="pricing__subtitle">Longer plans, lower price. Cancel anytime.</p>

    <% if @referral_code %>
      <div class="yellow-block">
        <h2>You have a referral code!</h2>
        <h2>Get 15% off any of the below options.</h2>
      </div>
    <% elsif @discount_code %>
      <% if @discount_percent.present? %>
        <div class="yellow-block">
          <h2>You have a discount code!</h2>
          <h2>Get <strong><%= number_to_percentage(@discount_percent * 100, precision: 0) %></strong> off any of the below options.</h2>
        </div>
      <% else %>
        <div class="yellow-block">
          <h2>You have a discount code!</h2>
          <h2>Get <strong>R<%= number_with_precision(@discount_amount || @discount_code_value, precision: 2) %></strong> off any of the below options.</h2>
        </div>
      <% end %>
    <% end %>

    <div class="pricing__cards">
      <% [
           { plan: "Standard", blurb: "Up to two 5L bags a week — perfect for the average home.", popular: false },
           { plan: "XL", blurb: "A full 25L bucket weekly — for big families & avid juicers.", popular: true },
         ].each do |card| %>
        <div class="pricing-card <%= 'pricing-card--popular' if card[:popular] %>" data-controller="pricing-card">
          <% if card[:popular] %><span class="pricing-card__badge">Most popular</span><% end %>
          <h3 class="pricing-card__title"><%= card[:plan] %></h3>

          <% [1, 3, 6].each do |duration| %>
            <% quote = PlanPricing.quote(plan: card[:plan], duration: duration, referral_code: @referral_code, discount_code: @discount_code, pct: @pct, amt: @amt) %>
            <div class="pricing-card__panel <%= 'hide' unless duration == 6 %>" data-pricing-card-target="panel" data-duration="<%= duration %>">
              <p class="pricing-card__price">
                <% if quote.discounted? %>
                  <s>R<%= number_with_precision(quote.original_per_month, precision: 0) %></s>
                <% elsif duration == 6 %>
                  From
                <% end %>
                R<%= number_with_precision(quote.per_month, precision: 0) %><span>/mo</span>
              </p>
              <p class="pricing-card__total">Total: R<%= number_with_precision(quote.total, precision: 0) %></p>
              <p class="pricing-card__blurb"><%= card[:blurb] %></p>
              <%= link_to "Choose #{card[:plan]}",
                    new_account_signup_path(plan: card[:plan], duration: duration, discount_code: @discount_code, referral: @referral_code),
                    class: "btn-gooi pricing-card__cta" %>
            </div>
          <% end %>

          <div class="pricing-card__pills">
            <button type="button" class="duration-pill" data-pricing-card-target="pill" data-duration="1" data-action="click->pricing-card#select">1 mo</button>
            <button type="button" class="duration-pill" data-pricing-card-target="pill" data-duration="3" data-action="click->pricing-card#select">3 mo</button>
            <button type="button" class="duration-pill duration-pill--active" data-pricing-card-target="pill" data-duration="6" data-action="click->pricing-card#select">6 mo</button>
          </div>
        </div>
      <% end %>

      <div class="pricing-card">
        <h3 class="pricing-card__title">Once-off</h3>
        <p class="pricing-card__price">R<%= number_with_precision(@once_off_price, precision: 0) %></p>
        <p class="pricing-card__blurb">Just trying it out? Book a single collection, no commitment.</p>
        <%= link_to "Book once-off", new_account_signup_path(plan: 'once_off'), class: "btn-gooi-outline pricing-card__cta" %>
      </div>
    </div>

    <p class="pricing__footnote">Per month on 1, 3 or 6-month plans — the longer you commit, the less you pay.</p>
  </div>
</section>
