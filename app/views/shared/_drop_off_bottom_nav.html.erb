<%# Same id and data-nav-path hook as the customer nav, so the existing
    updateBottomNavActive() in application.js highlights the current tab. %>
<nav class="customer-bottom-nav d-md-none" id="customer-bottom-nav" aria-label="Main navigation" data-turbo-permanent>
  <%= link_to drop_off_home_path_for(current_user), class: "bottom-nav-item", data: { nav_path: drop_off_home_path_for(current_user) } do %>
    <i class="fa-solid fa-house"></i>
    <span>Home</span>
  <% end %>

  <%= link_to drop_off_impact_path, class: "bottom-nav-item", data: { nav_path: drop_off_impact_path } do %>
    <i class="fa-solid fa-leaf"></i>
    <span>Impact</span>
  <% end %>

  <%= link_to drop_off_history_path, class: "bottom-nav-item", data: { nav_path: drop_off_history_path } do %>
    <i class="fa-solid fa-clock-rotate-left"></i>
    <span>Drop-offs</span>
  <% end %>

  <%= link_to account_path, class: "bottom-nav-item", data: { nav_path: account_path } do %>
    <i class="fa-solid fa-user"></i>
    <span>Account</span>
  <% end %>

  <%= link_to destroy_user_session_path, class: "bottom-nav-item", data: { turbo_method: :delete } do %>
    <i class="fa-solid fa-right-from-bracket"></i>
    <span>Log out</span>
  <% end %>
</nav>
