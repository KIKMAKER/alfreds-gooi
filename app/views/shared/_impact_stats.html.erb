<%# Reusable "live impact strip" — dark-green wavy band, numbers directly on
    the background (no card boxes), used on the homepage and About page.
    Locals:
      total_kg:         Integer, all-time kg diverted in scope
      kg_this_week:     Integer, kg diverted so far this week in scope
      household_count:  Integer, neighbours gooi-ing weekly in scope
      footnote:         optional String, shown small under the divider
    Presentation-only — all the arithmetic belongs in the caller (brand voice:
    ground every claim in a specific number, call people "neighbours"). %>
<%# locals: (total_kg:, kg_this_week:, household_count:, footnote: nil) %>
<% road_to_target_kg = 100_000
   road_to_percent = [(total_kg.to_f / road_to_target_kg * 100).round, 100].min %>
<section class="impact-summary">
  <%= raw %(
        <div class="wave-edge wave-edge--top">
          <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
              <path id="impact-wave-top" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-352z" />
            </defs>
            <use href="#impact-wave-top" x="0" y="0" />
          </svg>
        </div>
      ) %>
  <div class="impact-summary__inner" data-controller="counter">
    <div class="impact-summary__grid">
      <div class="impact-summary__item">
        <span class="impact-summary__number"
              data-counter-target="number"
              data-counter-value="<%= total_kg %>"
              data-counter-suffix=" kg"><%= number_with_delimiter(total_kg) %> kg</span>
        <span class="impact-summary__desc">diverted since 2023</span>
      </div>
      <div class="impact-summary__item">
        <span class="impact-summary__number"
              data-counter-target="number"
              data-counter-value="<%= kg_this_week %>"
              data-counter-prefix="~"
              data-counter-suffix=" kg">~<%= number_with_delimiter(kg_this_week) %> kg</span>
        <span class="impact-summary__desc">collected this week</span>
      </div>
      <div class="impact-summary__item">
        <span class="impact-summary__number"
              data-counter-target="number"
              data-counter-value="<%= household_count %>">
          <%= household_count %>
        </span>
        <span class="impact-summary__desc"><%= "neighbour".pluralize(household_count) %> gooi-ing weekly</span>
      </div>
    </div>

    <div class="impact-summary__road">
      <div class="impact-summary__road-label">
        <span>The road to 100 tonnes. Help us get there.</span>
        <span class="impact-summary__road-percent"><%= road_to_percent %>%</span>
      </div>
      <div class="impact-summary__road-track">
        <div class="impact-summary__road-fill" style="width: <%= road_to_percent %>%;"></div>
      </div>
    </div>

    <% if footnote.present? %>
      <p class="impact-summary__footnote"><%= footnote %></p>
    <% end %>
  </div>
  <%= raw %(
        <div class="wave-edge wave-edge--bottom">
          <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
              <path id="impact-wave-bottom" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-352z" />
            </defs>
            <use href="#impact-wave-bottom" x="0" y="0" />
          </svg>
        </div>
      ) %>
</section>
