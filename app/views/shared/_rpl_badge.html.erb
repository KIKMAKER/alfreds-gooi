<details class="rpl-badge <%= "rpl-badge--#{result.state}" if result.state %>">
  <summary>
    <span class="rpl-badge__rate">R<%= format('%.2f', result.rate) %></span><span class="rpl-badge__unit">/L</span>
  </summary>
  <div class="rpl-badge__details">
    <p class="rpl-badge__detail-row"><strong>Contracted R/L:</strong> R<%= format('%.2f', result.rate) %>/L</p>
    <% if result.realised_rate %>
      <p class="rpl-badge__detail-row"><strong>Realised R/L:</strong> R<%= format('%.2f', result.realised_rate) %>/L
        <span class="rpl-badge__detail-note">(actual, last 3 complete months)</span></p>
    <% end %>
    <% if result.floor_target %>
      <p class="rpl-badge__detail-row"><strong>Cost floor:</strong> R<%= format('%.2f', result.floor_target) %>/L</p>
      <p class="rpl-badge__detail-row"><strong>Price guidance:</strong> R<%= format('%.2f', result.price_guidance) %>/L</p>
      <p class="rpl-badge__detail-note">
        Assumes <%= number_with_delimiter(result.target_monthly_litres.to_i) %>L/month capacity.
        <% if result.state == :red %>
          Below cost floor.
        <% elsif result.state == :amber %>
          Above floor but below the <%= number_to_percentage((CostModel.current.minimum_margin_pct * 100), precision: 0) %> margin guidance.
        <% end %>
      </p>
    <% else %>
      <p class="rpl-badge__detail-note">No cost floor set — add a target_monthly_litres to the cost model.</p>
    <% end %>
    <p class="rpl-badge__detail-note"><%= result.note %></p>
  </div>
</details>
