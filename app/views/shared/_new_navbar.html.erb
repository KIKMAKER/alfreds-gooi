<div class="navbar-container new-navbar">
  <div class="inner-container">
    <%= link_to root_path, class: "new-nav-logo-link" do %>
      <%= image_tag('gooi_logo_CR.svg', class: 'gooi-logo') %>
    <% end %>

    <%# Desktop links — the homepage gets the brief's simpler, anchor-driven set;
        every other guest page keeps the full site nav (those anchors only make
        sense on the page that actually has #how-it-works etc.). %>
    <div class="links-container">
      <% if current_page?(root_path) %>
        <%= link_to 'How it works', "#how-it-works", class: "link-title" %>
        <%= link_to 'What you can gooi', "#what-you-can-gooi", class: "link-title" %>
        <%= link_to 'Pricing', "#pricing", class: "link-title" %>
        <%= link_to 'Business', "#business", class: "link-title" %>
        <%= link_to 'Sign up', "#pricing", class: "new-nav-cta-btn" %>
      <% else %>
        <%= link_to 'About', about_path, class: "link-title" %>
        <%= link_to 'FAQ', faq_path, class: "link-title" %>
        <%= link_to 'Get the app', get_the_app_path, class: "link-title" %>
        <%= link_to 'Farms', farms_path, class: "link-title" %>
      <% end %>

      <% if user_signed_in? %>
        <%= link_to "Log out", destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "new-nav-auth-btn" %>
      <% else %>
        <%= link_to "Log in", new_user_session_path, class: "new-nav-auth-btn" %>
      <% end %>
    </div>

    <%# Mobile hamburger — only for new-navbar %>
    <button class="new-nav-burger" id="newNavBurger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <%# Mobile drawer %>
  <div class="new-nav-drawer" id="newNavDrawer">
    <% if current_page?(root_path) %>
      <%= link_to 'How it works', "#how-it-works", class: "new-nav-drawer-link" %>
      <%= link_to 'What you can gooi', "#what-you-can-gooi", class: "new-nav-drawer-link" %>
      <%= link_to 'Pricing', "#pricing", class: "new-nav-drawer-link" %>
      <%= link_to 'Business', "#business", class: "new-nav-drawer-link" %>
      <%= link_to 'Sign up', "#pricing", class: "new-nav-drawer-link" %>
    <% else %>
      <%= link_to 'About', about_path, class: "new-nav-drawer-link" %>
      <%= link_to 'FAQ', faq_path, class: "new-nav-drawer-link" %>
      <%= link_to 'Get the app', get_the_app_path, class: "new-nav-drawer-link" %>
      <%= link_to 'Farms', farms_path, class: "new-nav-drawer-link" %>
      <%= link_to 'RFF', new_festival_session_path, class: "new-nav-drawer-link" %>
    <% end %>
    <div class="new-nav-drawer-divider"></div>
    <% if user_signed_in? %>
      <%= link_to "Log out", destroy_user_session_path,
            data: { turbo_method: :delete },
            class: "new-nav-drawer-link" %>
    <% else %>
      <%= link_to "Log in", new_user_session_path, class: "new-nav-drawer-link" %>
    <% end %>
  </div>
</div>

<script>
  (function() {
    var burger = document.getElementById('newNavBurger');
    var drawer = document.getElementById('newNavDrawer');
    if (!burger || !drawer) return;
    burger.addEventListener('click', function() {
      var open = drawer.classList.toggle('open');
      burger.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open);
    });
  })();
</script>
