<%= form_with model: [:admin, festival_event], class: "mt-3" do |f| %>
  <% if festival_event.errors.any? %>
    <div class="alert alert-danger">
      <% festival_event.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: "e.g. Splashy Fen 2026" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :start_date, class: "form-label" %>
      <%= f.date_field :start_date, class: "form-control" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :end_date, class: "form-label" %>
      <%= f.date_field :end_date, class: "form-control" %>
    </div>
  </div>

  <h2 class="h5 mt-4">Public impact page</h2>
  <p class="text-muted small">A shareable one-pager for phones. Tick the facts you want on it; leave the rest off.</p>

  <div class="mb-3">
    <%= f.label :slug, "Page address", class: "form-label" %>
    <div class="input-group">
      <span class="input-group-text">/festivals/</span>
      <%= f.text_field :slug, class: "form-control", placeholder: "pangea-2026" %>
    </div>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :published, class: "form-check-input" %>
    <%= f.label :published, "Published (anyone with the link can view)", class: "form-check-label" %>
  </div>

  <div class="mb-4">
    <%= f.collection_check_boxes :visible_facts, FestivalImpact::FACTS.to_a, :first, :last do |b| %>
      <div class="form-check">
        <%= b.check_box class: "form-check-input" %>
        <%= b.label class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <%= f.submit class: "fad-action-btn" %>
<% end %>
