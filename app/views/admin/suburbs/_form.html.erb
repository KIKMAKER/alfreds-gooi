<%= simple_form_for [:admin, @suburb] do |f| %>
  <%= f.input :name, placeholder: "e.g. Woodstock" %>

  <%= f.input :status,
        as: :select,
        collection: Suburb.statuses.keys.map { |s| [s.titleize, s] },
        prompt: false %>

  <%= f.input :collection_day,
        as: :select,
        collection: Suburb.collection_days.keys.map { |d| [d, d] },
        include_blank: "None yet" %>

  <%= f.button :submit, class: "small-yellow-btn" %>
<% end %>
