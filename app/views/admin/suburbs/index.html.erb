<div class="driver-wrapper">
  <h1>Suburbs</h1>

  <div class="d-flex flex-wrap gap-2 my-3">
    <%= link_to "New Suburb", new_admin_suburb_path, class: "small-yellow-btn" %>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Status</th>
        <th>Collection Day</th>
        <th>Launch Date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @suburbs.each do |suburb| %>
        <tr>
          <td><%= suburb.name %></td>
          <td><%= suburb.status.titleize %></td>
          <td><%= suburb.collection_day || "—" %></td>
          <td><%= suburb.launch_date&.strftime("%-d %b %Y") || "—" %></td>
          <td>
            <%= link_to "Edit", edit_admin_suburb_path(suburb) %>
            <%= link_to "Delete", admin_suburb_path(suburb), data: { turbo_method: :delete, turbo_confirm: "Delete #{suburb.name}?" } %>
            <% if suburb.launch_date.present? && !suburb.active? && !suburb.waitlist? %>
              <%= link_to "Start Pre-Launch", start_launch_admin_suburb_path(suburb),
                    data: { turbo_method: :post, turbo_confirm: "Open #{suburb.name} for pre-launch signups?" } %>
            <% end %>
            <% if suburb.waitlist? %>
              <%= link_to "We're Live", go_live_admin_suburb_path(suburb),
                    data: { turbo_method: :post, turbo_confirm: "Go live in #{suburb.name}? This closes the launch offer." } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
