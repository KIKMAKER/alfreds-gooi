      <line x1="792" y1="486" x2="792" y2="558" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
      <text x="824" y="514" font-family="Georgia, 'Libre Baskerville', serif" font-size="30" font-weight="bold" fill="#84cba3">R1.26m</text>
