<div class="blog-container">
  <section class="farm-hero">
    <div class="farm-hero__inner">
      <p class="farm-hero__eyebrow">Partner farm</p>
      <h1 class="farm-hero__title"><%= @farm.name %></h1>
      <h4 class="farm-hero__subtitle"><%= @farm.suburb&.name %></h4>
      <p class="farm-hero__story"><em>One of our valued composting partners, helping turn Cape Town's food waste into healthy soil.</em></p>
      <p class="farm-hero__story"><%= @farm.story %></p>
      <%= link_to "Sign up", root_path(anchor: "pricing"), class: "btn-gooi farm-hero__cta" %>
    </div>
    <%= raw %(
          <div class="wave-container">
            <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
              <defs>
                <path id="farm-gentle-wave"
                  d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-352z" />
              </defs>
              <g class="parallax">
                <use href="#farm-gentle-wave" x="0" y="0" fill="rgba(255,255,255)" />
              </g>
            </svg>
          </div>
        ) %>
  </section>

  <% if @farm.photo.attached? %>
    <div class="farm-images-container">
      <div class="img-1 farm-image">
        <%= image_tag @farm.photo, alt: @farm.name %>
      </div>
    </div>
  <% end %>

  <!-- Neighborhoods Served -->
  <% if @served_suburbs.any? %>
    <section class="farm-neighbourhoods">
      <div class="farm-neighbourhoods__inner">
        <h2 class="farm-neighbourhoods__title">Neighbourhoods served</h2>
        <p class="farm-neighbourhoods__subtitle">
          Every <%= @farm.collection_day %>, Alfred collects organic waste from these neighbourhoods and delivers it to <%= @farm.name %>.
        </p>
        <div class="suburbs-index__grid">
          <% @served_suburbs.each do |suburb| %>
            <%= link_to suburb_path(suburb), class: "suburbs-index__card" do %>
              <span class="suburbs-index__card-name"><%= suburb.name %></span>
              <span class="suburbs-index__card-meta">Collections every <%= suburb.collection_day&.capitalize %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Impact stats -->
  <section class="farm-impact">
    <%= raw %(
          <div class="wave-edge wave-edge--top">
            <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
              <defs>
                <path id="farm-impact-wave-top" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-352z" />
              </defs>
              <use href="#farm-impact-wave-top" x="0" y="0" />
            </svg>
          </div>
        ) %>
    <div class="farm-impact__inner">
      <h2 class="farm-impact__title">Our impact together</h2>
      <p class="farm-impact__subtitle">Since partnering with <%= @farm.name %>, we've made a real difference in diverting organic waste from landfills.</p>
      <div class="farm-impact__grid">
        <div class="farm-impact__item">
          <span class="farm-impact__number"><%= number_with_precision(@farm.total_weight_kg || 0, precision: 1) %>kg</span>
          <span class="farm-impact__desc">Total organic waste collected</span>
        </div>
        <div class="farm-impact__item">
          <span class="farm-impact__number"><%= @farm.total_dropoffs_count || 0 %></span>
          <span class="farm-impact__desc">Drop-offs completed</span>
        </div>
        <div class="farm-impact__item">
          <span class="farm-impact__number">Every <%= @farm.collection_day %></span>
          <span class="farm-impact__desc">Collection day</span>
        </div>
      </div>
    </div>
    <%= raw %(
          <div class="wave-edge wave-edge--bottom">
            <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
              <defs>
                <path id="farm-impact-wave-bottom" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-352z" />
              </defs>
              <use href="#farm-impact-wave-bottom" x="0" y="0" />
            </svg>
          </div>
        ) %>
  </section>

  <!-- Recent Drop-offs — same list-row styling as the driver's-day index -->
  <% if @recent_events.any? %>
    <section class="blog-text-section mt-4">
      <h1 class="farm-section-title">Recent Drop-offs</h1>
      <div class="dd-list mt-4">
        <% @recent_events.each do |event| %>
          <div class="dd-list-item">
            <div class="dd-list-item__icon">
              <i class="fa-solid fa-seedling"></i>
            </div>
            <div class="dd-list-item__main">
              <div class="dd-list-item__date"><%= event.date.strftime('%a, %d %b %Y') %></div>
            </div>
            <div class="dd-metrics">
              <div class="dd-metric">
                <div class="dd-metric__value"><%= number_with_precision(event.weight_kg || 0, precision: 1) %> kg</div>
                <div class="dd-metric__label">Weight</div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Social Links, Website, Location -->
  <section class="farm-connect">
    <div class="farm-connect__inner">
      <h1 class="farm-section-title">Connect with <%= @farm.name %></h1>

      <% if @farm.website.present? || @farm.instagram_handle.present? || @farm.facebook_url.present? %>
        <div class="farm-connect__social">
          <% if @farm.website.present? %>
            <%= link_to @farm.website, target: "_blank", class: "text-decoration-none" do %>
              <div class="farm-social-link">
                <i class="fa-solid fa-globe fa-2x me-2"></i>
                <span>Visit Website</span>
              </div>
            <% end %>
          <% end %>

          <% if @farm.instagram_handle.present? %>
            <%= link_to "https://instagram.com/#{@farm.instagram_handle}", target: "_blank", class: "text-decoration-none" do %>
              <div class="farm-social-link">
                <i class="fa-brands fa-instagram fa-2x me-2"></i>
                <span>@<%= @farm.instagram_handle %></span>
              </div>
            <% end %>
          <% end %>

          <% if @farm.facebook_url.present? %>
            <%= link_to @farm.facebook_url, target: "_blank", class: "text-decoration-none" do %>
              <div class="farm-social-link">
                <i class="fa-brands fa-facebook fa-2x me-2"></i>
                <span>Follow on Facebook</span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <p class="farm-connect__text">
        <%= @farm.name %> can be found in <%= @farm.suburb&.name %>. Feel free to pop in and connect with
        the soil, the farmers and the produce.
      </p>

      <% if @farm.latitude.present? && @farm.longitude.present? %>
        <% mapbox_token = Rails.application.credentials.dig(:mapbox, :public_token) || ENV['MAPBOX_API_KEY'] %>
        <% if mapbox_token.present? %>
          <div class="farm-connect__map">
            <%= image_tag "https://api.mapbox.com/styles/v1/mapbox/streets-v12/static/pin-l+013f3a(#{@farm.longitude},#{@farm.latitude})/#{@farm.longitude},#{@farm.latitude},14,0/800x400@2x?access_token=#{mapbox_token}",
                  alt: "Map showing #{@farm.name}'s location", loading: "lazy" %>
          </div>
        <% end %>
        <%= link_to "Open in Google Maps",
            "https://maps.google.com/?q=#{@farm.latitude},#{@farm.longitude}",
            target: "_blank",
            class: "btn-gooi-green farm-connect__map-cta" %>
      <% end %>
    </div>
  </section>

</div>
