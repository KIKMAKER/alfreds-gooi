<%# Public page for a suburb — three states:
    - waitlist?: pre-launch "lock in your OG rate" page with signup CTAs
    - active?:   "we're here" page — collection day, subscriber count, impact stats,
                 no signup CTAs (those live on the homepage)
    - target?:   "not here yet" page — no pricing/signup at all, just a nudge
                 toward the homepage's existing interest form (see the
                 suburb-cta-section swap below)
    SuburbsController#show 404s for any other status. %>

<div class="suburb-hero">
  <div class="suburb-hero__text">
    <h1 class="suburb-hero__title">Your kitchen scraps deserve a <span class="suburb-hero__title-highlight">second life</span>.</h1>
    <p class="suburb-hero__subtitle">
      Gooi makes composting your food waste as easy as throwing it in the bin — weekly
      doorstep collection, no mess, no effort.
    </p>
    <% if @suburb.waitlist? %>
      <%= link_to "Lock in your rate", "#pricing", class: "btn-gooi suburb-hero__cta" %>
    <% elsif @suburb.active? %>
      <p class="suburb-hero__stats">
        <strong>~<%= number_with_delimiter(@impact_total_kg) %>kg</strong> diverted from landfill,
        <strong>~<%= number_with_delimiter(@impact_kg_this_week) %>kg</strong> this week —
        <strong><%= @household_count %></strong> <%= "neighbour".pluralize(@household_count) %> gooi-ing weekly.
      </p>
      <%= link_to "Sign up here", root_path(anchor: "pricing"), class: "btn-gooi suburb-hero__cta" %>
    <% else %>
      <p class="suburb-hero__stats">
        We're not gooi-ing in <%= @suburb.name %> yet — but every neighbour who lets us know moves it up the list.
      </p>
      <%= link_to "Let us know you're ready", root_path(anchor: "interest", suburb_id: @suburb.id), class: "btn-gooi suburb-hero__cta" %>
    <% end %>
  </div>

  <div class="suburb-hero__image-wrap">
    <%= image_tag "suburb_launch_hero.jpg", alt: "Gooi kitchen scrap collection", class: "suburb-hero__image" %>
    <div class="suburb-hero__overlay-card">
      <% if @suburb.waitlist? %>
        <p class="suburb-hero__overlay-card-main">Coming to <strong><%= @suburb.name %></strong></p>
        <p class="suburb-hero__overlay-card-sub">
          Lock in a discount rate before <strong><%= @suburb.launch_date.strftime("%-d %B %Y") %></strong>.
        </p>
      <% elsif @suburb.active? %>
        <p class="suburb-hero__overlay-card-main">Now serving <strong><%= @suburb.name %></strong></p>
        <p class="suburb-hero__overlay-card-sub">
          Collections every <strong><%= @suburb.collection_day&.capitalize %></strong>.
        </p>
      <% else %>
        <p class="suburb-hero__overlay-card-main">Not in <strong><%= @suburb.name %></strong> yet</p>
        <p class="suburb-hero__overlay-card-sub">
          Register your interest and we'll let you know the moment we're ready.
        </p>
      <% end %>
    </div>
  </div>

  <%= raw %(
        <div class="wave-container">
          <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
              <path id="suburb-gentle-wave"
                d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-352z" />
            </defs>
            <g class="parallax">
              <use href="#suburb-gentle-wave" x="0" y="0" fill="rgba(255,255,255)" />
            </g>
          </svg>
        </div>
      ) %>
</div>

<% if @suburb.waitlist? %>

  <section id="pricing" class="suburb-pricing">
    <p class="suburb-pricing__eyebrow">Locked-in launch rate</p>
    <h2 class="suburb-pricing__title">Sign up early, save for the life of your subscription</h2>

    <div class="standard-months-container">
      <% if @standard_og %>
        <div class="month-card popular">
          <h4>Most popular</h4>
          <h3>Standard</h3>
          <p class="pricing-text">
            <strong>R<%= number_with_precision(@standard_og.price / 6.0, precision: 0) %></strong> per month
          </p>
          <p class="pricing-text">
            <strong>Total:</strong> R<%= number_with_precision(@standard_og.price, precision: 0) %>
          </p>
          <div class="sign-up-btn">
            <%= link_to "Select", new_account_signup_path(plan: "Standard", duration: "6", suburb_id: @suburb.id, og: true), class: "link-title-light" %>
          </div>
        </div>
      <% end %>

      <% if @xl_og %>
        <div class="month-card">
          <h3>XL</h3>
          <p class="pricing-text">
            <strong>R<%= number_with_precision(@xl_og.price / 6.0, precision: 0) %></strong> per month
          </p>
          <p class="pricing-text">
            <strong>Total:</strong> R<%= number_with_precision(@xl_og.price, precision: 0) %>
          </p>
          <div class="sign-up-btn">
            <%= link_to "Select", new_account_signup_path(plan: "XL", duration: "6", suburb_id: @suburb.id, og: true), class: "link-title-light" %>
          </div>
        </div>
      <% end %>
    </div>

    <p class="suburb-pricing__note">
      Pricing goes up to R180/month once <%= @suburb.name %> launches — lock in this rate now.
    </p>
    <p class="suburb-pricing__link">
      <%= link_to "See all plans and pricing", root_path(anchor: "pricing") %>
    </p>
  </section>

<% end %>

<% feeder_farms = @suburb.feeder_farms %>
<% if feeder_farms.any? %>
  <section class="suburb-farms">
    <div class="suburb-farms__inner">
      <h2 class="suburb-farms__title">The Farm(s) <%= @suburb.name %> feeds</h2>
      <p class="suburb-farms__subtitle">
        Every <%= @suburb.collection_day %>, scraps from <%= @suburb.name %> head here to become compost.
      </p>
      <div class="farms-grid">
        <% feeder_farms.each do |farm| %>
          <div class="farm-card-mini">
            <%= link_to farm_path(farm), class: "farm-card-link" do %>
              <div class="farm-image-container">
                <% if farm.photo.attached? %>
                  <%= image_tag farm.photo, alt: farm.name, class: "farm-image" %>
                <% else %>
                  <div class="farm-image-placeholder">
                    <i class="fa-solid fa-seedling"></i>
                  </div>
                <% end %>
                <span class="collection-day-badge"><%= farm.collection_day %></span>
              </div>
              <div class="farm-card-content">
                <div class="d-flex justify-content-between align-items-center">
                  <h3><%= farm.name %></h3>
                  <p class="farm-suburb"><i class="fa-solid fa-location-dot"></i> <%= farm.suburb&.name %></p>
                </div>
                <span class="farm-stat"><%= number_with_precision(farm.total_weight_kg || 0, precision: 0) %> kg collected</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<% if @suburb.target? %>
  <section class="suburb-cta-section">
    <div class="suburb-cta-section__overlay">
      <div class="other-options-section">
        <div class="other-options-row">
          <div class="other-option-card other-option-card--interest">
            <h3>We're not in <%= @suburb.name %> yet</h3>
            <p>We plan our routes suburb by suburb, and interest is what tips the decision. Let us know you're ready and we'll be in touch the moment we're headed your way.</p>
            <ul>
              <li>No commitment, just a show of hands</li>
              <li>We'll email you the moment we launch nearby</li>
              <li>Bring your street along too — the more neighbours, the sooner we come</li>
            </ul>
            <div class="mt-auto pt-3">
              <%= link_to "Register your interest", root_path(anchor: "interest", suburb_id: @suburb.id), class: "btn-gooi" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>
