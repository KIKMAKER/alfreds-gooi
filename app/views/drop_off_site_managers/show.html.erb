<div class="subscription-show-container">

  <%# ─── HEADER ─── %>
  <div class="subscription-header mb-3">
    <div class="subscription-header-content">
      <div class="subscription-avatar">
        <i class="fa-solid fa-recycle"></i>
      </div>
      <div>
        <h1>Hey <%= current_user.first_name || @drop_off_site.contact_name %>!</h1>
        <p class="dom-header__sub">
          <%= @drop_off_site.name %> &middot; <%= @drop_off_site.collection_day %>s
        </p>
      </div>
    </div>
    <% if @show_index_link %>
      <%= link_to drop_off_site_managers_path, class: "dom-header__back" do %>
        <i class="fa-solid fa-arrow-left"></i> All sites
      <% end %>
    <% end %>
  </div>

  <% if @drop_off_site.photo.attached? %>
    <div class="dom-photo mb-3">
      <%= image_tag @drop_off_site.photo, class: "dom-photo__img", alt: @drop_off_site.name %>
    </div>
  <% end %>

  <%# ─── NEXT DROP-OFF ─── %>
  <div class="info-card mb-3">
    <div class="info-card-header">
      <i class="fa-solid fa-truck"></i>
      <h3>Next drop-off</h3>
    </div>
    <div class="info-card-body">
      <% if @next_event %>
        <div class="info-row">
          <span class="info-label"><%= @next_event.today? ? "Today" : @next_event.date.strftime("%A, %-d %b") %></span>
          <span class="info-value">
            <%= @next_event.protein_waste_stream? ? "Protein" : "Food scraps" %>
          </span>
        </div>
      <% else %>
        <p class="dom-empty mb-0">
          Alfred normally drops off on <%= @drop_off_site.collection_day %>s. We'll show the next stop here once it's on the route.
        </p>
      <% end %>
    </div>
  </div>

  <%# ─── STATS ─── %>
  <div class="stats-grid mb-3">
    <div class="stat-card">
      <div class="stat-icon dom-stat-icon--leaf">
        <i class="fa-solid fa-weight-scale"></i>
      </div>
      <div class="stat-content">
        <div class="stat-value"><%= number_with_delimiter(@total_kg.round) %>kg</div>
        <div class="stat-label">received so far</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon dom-stat-icon--green">
        <i class="fa-solid fa-truck-ramp-box"></i>
      </div>
      <div class="stat-content">
        <div class="stat-value"><%= @total_dropoffs %></div>
        <div class="stat-label">drop-offs</div>
      </div>
    </div>
  </div>

  <%# ─── DISPOSAL FEE (charging sites only) ─── %>
  <% if @month_fees %>
    <div class="info-card mb-3">
      <div class="info-card-header">
        <i class="fa-solid fa-receipt"></i>
        <h3>Disposal fee &middot; <%= Date.current.strftime("%B") %></h3>
      </div>
      <div class="info-card-body">
        <% unless @drop_off_site.fees_started? %>
          <div class="info-row">
            <span class="info-label">Fees start</span>
            <span class="info-value"><%= @drop_off_site.fee_start_date.strftime("%-d %b %Y") %></span>
          </div>
        <% end %>
        <div class="info-row">
          <span class="info-label">Rate</span>
          <span class="info-value"><%= number_to_currency(@drop_off_site.fee_per_kg, unit: "R") %> / kg</span>
        </div>
        <div class="info-row">
          <span class="info-label">Received this month</span>
          <span class="info-value"><%= number_with_precision(@month_fees[:kg], precision: 1) %> kg</span>
        </div>
        <div class="info-row">
          <span class="info-label">Fee so far</span>
          <span class="info-value"><%= number_to_currency(@month_fees[:fee], unit: "R") %></span>
        </div>
      </div>
    </div>
  <% end %>

  <%# ─── RECENT DROP-OFFS ─── %>
  <div class="info-card mb-3">
    <div class="info-card-header">
      <i class="fa-solid fa-clock-rotate-left"></i>
      <h3>Recent drop-offs</h3>
    </div>
    <div class="info-card-body">
      <% if @recent_events.any? %>
        <% @recent_events.each do |event| %>
          <div class="info-row">
            <span class="info-label"><%= event.date.strftime("%-d %b %Y") %></span>
            <span class="info-value dom-status <%= event.is_done ? 'dom-status--done' : 'dom-status--pending' %>">
              <% if event.is_done %>
                <%= number_with_precision(event.total_weight_from_buckets, precision: 1) %> kg &middot; <%= pluralize(event.buckets.size, "bucket") %>
              <% else %>
                Pending
              <% end %>
            </span>
          </div>
        <% end %>
        <%= link_to drop_off_history_path, class: "action-btn mt-3" do %>
          <i class="fa-solid fa-list"></i> View all drop-offs
        <% end %>
      <% else %>
        <p class="dom-empty mb-0">No drop-offs recorded yet.</p>
      <% end %>
    </div>
  </div>

  <%# ─── FACILITY CONFIRMATION ─── %>
  <div class="info-card mb-3">
    <div class="info-card-header">
      <i class="fa-solid fa-file-circle-check"></i>
      <h3>Facility confirmation</h3>
    </div>
    <div class="info-card-body">
      <div class="info-row">
        <span class="info-label">Max per delivery</span>
        <span class="info-value">
          <%= @drop_off_site.max_kg_per_delivery ? "#{number_with_precision(@drop_off_site.max_kg_per_delivery, precision: 0)} kg" : "Not recorded" %>
        </span>
      </div>

      <% if @drop_off_site.letter_approved? %>
        <div class="info-row">
          <span class="info-label">Status</span>
          <span class="info-value dom-status--done">Listed facility</span>
        </div>
        <% if @drop_off_site.facility_confirmation_letter.attached? %>
          <div class="info-row">
            <span class="info-label">Signed letter</span>
            <span class="info-value">
              <%= link_to "On file", rails_blob_path(@drop_off_site.facility_confirmation_letter, disposition: "attachment") %>
            </span>
          </div>
        <% end %>
      <% elsif @drop_off_site.letter_submitted? %>
        <div class="info-row">
          <span class="info-label">Status</span>
          <span class="info-value dom-status--pending">Under review</span>
        </div>
        <p class="dom-copy mb-0">We have your signed letter and will confirm shortly.</p>
      <% else %>
        <% if @drop_off_site.letter_rejected? && @drop_off_site.facility_rejection_reason.present? %>
          <p class="dom-note"><%= @drop_off_site.facility_rejection_reason %></p>
        <% end %>
        <p class="dom-copy">
          To list <%= @drop_off_site.name %> as a registered composting facility, we need a signed confirmation letter on file.
          It supports Gooi's City of Cape Town accreditation.
        </p>
        <%# Cost is only ever mentioned for sites that charge. %>
        <% if @drop_off_site.charges_disposal_fee? %>
          <p class="dom-copy dom-copy--strong">We can't pay you unless you're listed as a facility.</p>
        <% end %>
        <ol class="dom-steps">
          <li>
            <%= link_to "Download the letter template", letter_template_drop_off_site_manager_path(@drop_off_site) %>
            and fill in your details.
          </li>
          <li>Sign it, then scan or photograph it.</li>
          <li>Upload it here (PDF, JPG or PNG).</li>
        </ol>
        <%= form_with url: submit_letter_drop_off_site_manager_path(@drop_off_site), method: :post, multipart: true, class: "dom-upload" do |f| %>
          <%= file_field_tag :facility_letter, accept: ".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png", required: true, class: "form-control" %>
          <%= f.submit "Upload signed letter", class: "action-btn" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ─── SITE DETAILS ─── %>
  <div class="info-card mb-3">
    <div class="info-card-header">
      <i class="fa-solid fa-id-card"></i>
      <h3>Site details</h3>
    </div>
    <div class="info-card-body">
      <div class="info-row">
        <span class="info-label">Address</span>
        <span class="info-value"><%= @drop_off_site.street_address %>, <%= @drop_off_site.suburb&.name %></span>
      </div>
      <div class="info-row">
        <span class="info-label">Contact</span>
        <span class="info-value"><%= @drop_off_site.contact_name %></span>
      </div>
      <div class="info-row">
        <span class="info-label">WhatsApp</span>
        <span class="info-value"><%= @drop_off_site.phone_number %></span>
      </div>
      <% if @drop_off_site.notes.present? %>
        <div class="info-row">
          <span class="info-label">Notes</span>
          <span class="info-value"><%= @drop_off_site.notes %></span>
        </div>
      <% end %>
      <div class="dom-actions mt-3">
        <%= link_to edit_drop_off_site_manager_path(@drop_off_site), class: "action-btn" do %>
          <i class="fa-solid fa-pen"></i> Edit details
        <% end %>
        <% whatsapp_message = "Hello, it is #{@drop_off_site.contact_name} from #{@drop_off_site.name}. Please contact me." %>
        <%= link_to "https://wa.me/27785325513?text=#{ERB::Util.url_encode(whatsapp_message)}",
                    target: :_blank, rel: "noopener", class: "action-btn" do %>
          <i class="fa-brands fa-whatsapp"></i> WhatsApp Alfred
        <% end %>
      </div>
    </div>
  </div>

</div>
