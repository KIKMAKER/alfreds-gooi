<div class="subscription-show-container">

  <div class="subscription-header mb-3">
    <div class="subscription-header-content">
      <div class="subscription-avatar">
        <i class="fa-solid fa-recycle"></i>
      </div>
      <div>
        <h1>Hey <%= current_user.first_name %>!</h1>
        <p class="dom-header__sub"><%= pluralize(@drop_off_sites.size, "drop-off site") %></p>
      </div>
    </div>
  </div>

  <% @drop_off_sites.each do |site| %>
    <div class="info-card mb-3">
      <div class="info-card-header">
        <i class="fa-solid fa-location-dot"></i>
        <h3><%= site.name %></h3>
      </div>
      <div class="info-card-body">
        <div class="info-row">
          <span class="info-label">Collection day</span>
          <span class="info-value"><%= site.collection_day %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Suburb</span>
          <span class="info-value"><%= site.suburb&.name %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Received</span>
          <span class="info-value"><%= number_with_precision(site.total_weight_kg, precision: 1) %> kg</span>
        </div>
        <% if site.action_needed? %>
          <%= link_to compliance_drop_off_site_manager_path(site), class: "dom-alert dom-alert--compact mt-3" do %>
            <i class="fa-solid fa-triangle-exclamation"></i> Action needed: complete compliance
          <% end %>
        <% end %>
        <%= link_to drop_off_site_manager_path(site), class: "action-btn mt-3" do %>
          View site <i class="fa-solid fa-arrow-right"></i>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
